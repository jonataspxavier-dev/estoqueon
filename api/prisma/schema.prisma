generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  GERENTE
  VENDEDOR
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(150)
  senhaHash     String         @map("senha_hash") @db.VarChar(100)
  perfil        Perfil
  movimentacoes Movimentacao[]
  vendas        Venda[]

  @@map("usuario")
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique @db.VarChar(80)
  produtos Produto[]

  @@map("categoria")
}

model Produto {
  id            Int            @id @default(autoincrement())
  sku           String         @unique @db.VarChar(50)
  nome          String         @db.VarChar(150)
  categoriaId   Int            @map("categoria_id")
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  precoCusto    Decimal        @map("preco_custo") @db.Decimal(10, 2)
  precoVenda    Decimal        @map("preco_venda") @db.Decimal(10, 2)
  estoqueAtual  Int            @default(0) @map("estoque_atual")
  estoqueMinimo Int            @default(0) @map("estoque_minimo")
  ativo         Boolean        @default(true)
  movimentacoes Movimentacao[]
  itensVenda    VendaItem[]

  @@index([nome])
  @@index([categoriaId])
  @@map("produto")
}

model Movimentacao {
  id               Int              @id @default(autoincrement())
  produtoId        Int              @map("produto_id")
  produto          Produto          @relation(fields: [produtoId], references: [id])
  tipo             TipoMovimentacao
  quantidade       Int
  estoqueAnterior  Int              @map("estoque_anterior")
  estoquePosterior Int              @map("estoque_posterior")
  motivo           String           @db.VarChar(255)
  usuarioId        Int              @map("usuario_id")
  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  vendaId          Int?             @map("venda_id")
  criadoEm         DateTime         @default(now()) @map("criado_em")

  @@index([produtoId, criadoEm])
  @@index([criadoEm])
  @@map("movimentacao")
}

model Venda {
  id        Int         @id @default(autoincrement())
  usuarioId Int         @map("usuario_id")
  usuario   Usuario     @relation(fields: [usuarioId], references: [id])
  total     Decimal     @db.Decimal(12, 2)
  criadoEm  DateTime    @default(now()) @map("criado_em")
  itens     VendaItem[]

  @@index([criadoEm])
  @@map("venda")
}

model VendaItem {
  id            Int     @id @default(autoincrement())
  vendaId       Int     @map("venda_id")
  venda         Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     Int     @map("produto_id")
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  /// Custo do produto no momento da venda (para calcular lucro bruto com precisão)
  custoUnitario Decimal @map("custo_unitario") @db.Decimal(10, 2)

  @@index([produtoId])
  @@map("venda_item")
}
